# Build output (regenerable)
/build/
/build-*/

# Vendored deps (regenerable via `bash fetch-deps.sh <arch>`)
/vendor/

# Test artifacts (regenerable)
build/*.log
build/*.tox
build/*.tox.*
build/test_*

# Build/verification scratch (logs at the repo root)
/win-*.log
/linux-*.log
/t-*.log
/e2ee-out.log
/*.o

# Release archives (regenerable; distributed out of band)
/TkTox-*.zip
/TkTox-*.zip.sha256

# Security-audit scratch (evidence logs + PoC harnesses + report; local only)
audit-*.txt
audit-cve/
tests/audit_*.c
AUDIT_REPORT.md

# Runtime profiles (user data — never commit)
*.tox
*.tox.oq
*.tox.tt
*.tox.ses
*.tox.ava
*.tox.hist
*.tox.rsum

# Qwen Code tooling scratch (never commit)
/.qwen/
